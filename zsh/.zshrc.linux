# Linux-specific zsh config

# ls with colors (GNU ls)
alias ls='ls --color=always'

# Hostname in prompt if not main machine
if [[ $(< /etc/hostname) != "thinkpadx1" ]]; then
  PROMPT="(%F{yellow}$(< /etc/hostname)%f) $PROMPT"
fi

# Android development
export ANDROID_HOME=$HOME/Android/Sdk
export PATH=$PATH:$ANDROID_HOME/emulator
export PATH=$PATH:$ANDROID_HOME/tools
export PATH=$PATH:$ANDROID_HOME/tools/bin
export PATH=$PATH:$ANDROID_HOME/platform-tools

# TeX Live paths
export PATH="/usr/local/texlive/2024/bin/x86_64-linux:$PATH"
export MANPATH="/usr/local/texlive/2024/texmf-dist/doc/man:$MANPATH"
export INFOPATH="/usr/local/texlive/2024/texmf-dist/doc/info:$INFOPATH"

# Deno
export DENO_INSTALL="$HOME/.deno"
export PATH="$DENO_INSTALL/bin:$PATH"
export DVM_DIR="$HOME/.dvm"
export PATH="$DVM_DIR/bin:$PATH"

# Google Cloud SDK
if [ -f "$HOME/tmp/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/tmp/google-cloud-sdk/path.zsh.inc"; fi
if [ -f "$HOME/tmp/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/tmp/google-cloud-sdk/completion.zsh.inc"; fi

# EB CLI
export PATH="$HOME/.ebcli-virtual-env/executables:$PATH"

# kubectl completion
if (( $+commands[kubectl] )); then
  source <(kubectl completion zsh)
  compdef _kubectl kubectl
fi

# Ruby gems
export PATH="$HOME/.local/share/gem/ruby/3.4.0/bin:$PATH"
